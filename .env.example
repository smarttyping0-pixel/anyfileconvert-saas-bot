# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_from_botfather

# AI API Keys
GEMINI_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key_optional

# Monetization & Payment Settings
# Telegram Stars is native, or use Stripe Provider Token
PAYMENT_PROVIDER_TOKEN=your_stripe_or_payment_provider_token

# Admin User IDs (comma-separated Telegram User IDs)
ADMIN_IDS=123456789,987654321

# Bot Quotas & SaaS Settings
FREE_DAILY_CREDITS=10
PRO_MONTHLY_CREDITS=500

# Mini App URL (HTTPS url after hosting on Render/Localtunnel/Vercel)
WEB_APP_URL=https://your-app-url.onrender.com
